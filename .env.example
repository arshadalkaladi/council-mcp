# council-mcp environment (example). Copy to .env and edit. NEVER commit .env.
# Phase 1A uses only the first three. Later phases add auth/provider settings.

# --- Server ---
COUNCIL_MCP_HOST=127.0.0.1
COUNCIL_MCP_PORT=8080
COUNCIL_MCP_ENV=development

# --- Reasoning provider (Phase 2B) ---
# Default is the deterministic demo provider; no key required, nothing leaves host.
# REASONING_PROVIDER=deterministic
# To opt into an external provider later (OFF by default):
# REASONING_PROVIDER=external
# EXTERNAL_PROVIDER_KIND=ollama          # e.g. local Ollama; no key needed
# EXTERNAL_PROVIDER_KEY=                  # only for hosted APIs; secret, never logged/stored

# --- OAuth 2.1 (Phase 1B) ---
# Placeholders only; real values supplied out-of-band, never committed.
# OAUTH_ISSUER=
# OAUTH_AUDIENCE=
