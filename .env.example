# council-mcp environment (example). Copy to .env and edit. NEVER commit .env.
# Phase 1A uses only the first three. Later phases add auth/provider settings.

# --- Server ---
COUNCIL_MCP_HOST=127.0.0.1
COUNCIL_MCP_PORT=8080
COUNCIL_MCP_ENV=development

# --- Reasoning provider ---
# Default is the deterministic demo provider: offline, zero-cost, reproducible.
# REASONING_PROVIDER=deterministic
# Opt into the optional LOCAL Ollama provider (OFF by default; no API key needed;
# any failure falls back to deterministic reasoning automatically):
# REASONING_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# --- OAuth 2.1 (Phase 1B) ---
# Placeholders only; real values supplied out-of-band, never committed.
# OAUTH_ISSUER=
# OAUTH_AUDIENCE=
